rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function userDoc(userId) {
      return get(/databases/$(database)/documents/users/$(userId));
    }

    function isPublic(userId) {
      return exists(/databases/$(database)/documents/users/$(userId))
        && userDoc(userId).data.isPrivate != true
        && userDoc(userId).data.hideFollowLists != true;
    }

    function isApprovedFollower(viewerId, targetId) {
      return exists(/databases/$(database)/documents/follows/$(viewerId + "_" + targetId))
        && get(/databases/$(database)/documents/follows/$(viewerId + "_" + targetId)).data.status == "active";
    }

    function isChatParticipant(chatId) {
      let chatDoc = get(/databases/$(database)/documents/chats/$(chatId));
      return isSignedIn()
        && chatDoc != null
        && request.auth.uid in chatDoc.data.participantIds;
    }

    // ── Users ──────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId)
        || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys()
      .hasOnly(['followersCount', 'followingCount']));
      allow delete: if isOwner(userId);

      // ── Notifications subcollection ────────────────────────────────────
      // Each user can only read/write their own notifications.
      // Other authenticated users (e.g. message senders) can create
      // notifications for a recipient, but cannot read or modify them.
      match /notifications/{notificationId} {
        // Only the owner can read their notifications
        allow read: if isOwner(userId);

        // Any signed-in user can create a notification for another user
        // (e.g. sender creates notification for recipient)
        allow create: if isSignedIn();

        // Only the recipient (owner) can update (mark as read) or delete
        allow update, delete: if isOwner(userId);
      }



    }

    // ── User Preferences & Reports ─────────────────────────────────────────
    match /users/{userId}/preferences/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /reports/{reportId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false; 
    }

    // ── Follows ────────────────────────────────────────────────────────────
    match /follows/{followId} {
      allow read: if isSignedIn() && (
      resource == null ||
      resource.data.followerId == request.auth.uid ||
      resource.data.followedId == request.auth.uid ||
      isPublic(resource.data.followedId) ||
      isPublic(resource.data.followerId) ||
      isApprovedFollower(request.auth.uid, resource.data.followedId) ||
      isApprovedFollower(request.auth.uid, resource.data.followerId)
      );

      allow create: if isSignedIn()
        && request.resource.data.followerId == request.auth.uid
        && exists(/databases/$(database)/documents/users/$(request.resource.data.followedId));

      allow update, delete: if isSignedIn() && (
      resource.data.followerId == request.auth.uid ||
      resource.data.followedId == request.auth.uid
      );
    }

    // ── Chats ─────────────────────────────────────────────────────────────
    match /chats/{chatId} {
      allow read: if isSignedIn()
        && request.auth.uid in resource.data.participantIds;
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participantIds;
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participantIds;
      allow delete: if isSignedIn()
        && request.auth.uid in resource.data.participantIds;
    }

    // ── Messages Collection Group ──────────────────────────────────────
    // Used for global message listener across all chats
    match /{path=**}/messages/{messageId} {
      allow read: if isSignedIn() 
        && request.auth.uid in resource.data.participantIds;
    }

    // ── Messages subcollection ─────────────────────────────────────────
    // For direct path access
    match /chats/{chatId}/messages/{messageId} {
      allow read: if isChatParticipant(chatId);
      allow create: if isChatParticipant(chatId)
        && request.resource.data.senderId == request.auth.uid;
      // Update rules:
      // 1. Sender can edit/delete own message (including deletedForEveryone & isDeleted)
      // 2. Any participant can update reactions and read receipts
      allow update: if isChatParticipant(chatId)
        && request.resource.data.chatId == resource.data.chatId
        && request.resource.data.senderId == resource.data.senderId
        && request.resource.data.messageId == resource.data.messageId
        && (
          // Sender can update their own message
          (
            resource.data.senderId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'content',
              'mediaUrl',
              'thumbnailUrl',
              'isEdited',
              'updatedAt',
              'isDeleted',
              'deletedForEveryone',
              'reactions',
              'readReceipts',
              'deliveryReceipts',
              'messageStatus',
              'readAt',
              'deliveredAt'
            ])
            && (
              // If deletedForEveryone is requested, enforce 1-hour window from creation
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['deletedForEveryone'])
              || request.resource.data.deletedForEveryone != true
              || (request.time.toMillis() - resource.data.createdAt <= 3600000)
            )
          )
          ||
          // Any participant can update reactions, receipts, and delivery timestamps
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'reactions',
              'readReceipts',
              'deliveryReceipts',
              'messageStatus',
              'readAt',
              'deliveredAt',
              'updatedAt'
            ])
          )
        );
      allow delete: if isChatParticipant(chatId)
        && resource.data.senderId == request.auth.uid;
    }

    // ── Notes ─────────────────────────────────────────────────────────────
    match /notes/{noteId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.noteType in ['TEXT', 'MUSIC', 'LOCATION', 'COUNTDOWN', 'GIF'];

      allow update, delete: if isSignedIn()
        && resource.data.authorId == request.auth.uid;
    }

    // ── Stories ───────────────────────────────────────────────────────────
    match /stories/{storyId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid;

      allow update: if isSignedIn() && (
        resource.data.authorId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['viewsCount', 'likesCount'])
      );

      allow delete: if isSignedIn()
        && resource.data.authorId == request.auth.uid;

      match /viewers/{viewerId} {
        allow read, write: if isSignedIn() && (request.auth.uid == viewerId || resource.data.authorId == request.auth.uid);
      }
    }

    // ── Links ─────────────────────────────────────────────────────────────
    match /links/{linkId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid;

      allow update: if isSignedIn() && (
        resource.data.authorId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['likesCount', 'sharesCount', 'relinksCount', 'savesCount', 'viewsCount', 'commentsCount'])
      );

      allow delete: if isSignedIn()
        && resource.data.authorId == request.auth.uid;

      match /likes/{userId} {
        allow read, write: if isSignedIn() && (request.auth.uid == userId || resource.data.authorId == request.auth.uid);
      }
    }

    // ── Comments ──────────────────────────────────────────────────────────
    match /comments/{commentId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid;

      allow update: if isSignedIn() && (
        resource.data.authorId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['likesCount', 'replyCount'])
      );

      allow delete: if isSignedIn()
        && resource.data.authorId == request.auth.uid;

      match /likes/{userId} {
        allow read, write: if isSignedIn() && (request.auth.uid == userId || resource.data.authorId == request.auth.uid);
      }
    }
  }
}
