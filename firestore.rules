rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ───────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function userDoc(userId) {
      return get(/databases/$(database)/documents/users/$(userId));
    }

    // A user is considered public if their user doc exists and isPrivate is not true.
    function isPublic(userId) {
      return exists(/databases/$(database)/documents/users/$(userId))
        && (!('isPrivate' in userDoc(userId).data) || userDoc(userId).data.isPrivate != true);
    }

    // Checks if viewerId is an active approved follower of targetId
    function isApprovedFollower(viewerId, targetId) {
      let followDocPath = /databases/$(database)/documents/follows/$(viewerId + "_" + targetId);
      return exists(followDocPath)
        && get(followDocPath).data.get('status', '') == 'active';
    }

    // General content access check: owner, public author, or approved follower
    function canViewUserContent(authorId) {
      return isSignedIn() && (
        isOwner(authorId)
        || isPublic(authorId)
        || isApprovedFollower(request.auth.uid, authorId)
      );
    }

    // Follow list access check: owner can always view; non-owners must respect hideFollowLists and isPrivate
    function canViewUserFollows(targetUserId) {
      return isOwner(targetUserId)
        || (
          exists(/databases/$(database)/documents/users/$(targetUserId))
          && (!('hideFollowLists' in userDoc(targetUserId).data) || userDoc(targetUserId).data.hideFollowLists != true)
          && (isPublic(targetUserId) || isApprovedFollower(request.auth.uid, targetUserId))
        );
    }

    function isChatParticipant(chatId) {
      let chatDoc = get(/databases/$(database)/documents/chats/$(chatId));
      return isSignedIn()
        && chatDoc != null
        && request.auth.uid in chatDoc.data.participantIds;
    }

    // Validates single-step counter increments/decrements (+1 / -1) by non-owners and prevents negative values
    function isValidCounterDelta(field) {
      return !(field in request.resource.data.diff(resource.data).affectedKeys())
        || (
          request.resource.data[field] is int
          && request.resource.data[field] >= 0
          && (
            (field in resource.data)
              ? (request.resource.data[field] == resource.data[field] + 1
                 || request.resource.data[field] == resource.data[field] - 1)
              : (request.resource.data[field] == 1)
          )
        );
    }

    // Validates strictly monotonic single-step counter increments (+1 only), strictly preventing decrement attacks
    function isValidIncrementOnlyDelta(field) {
      return !(field in request.resource.data.diff(resource.data).affectedKeys())
        || (
          request.resource.data[field] is int
          && request.resource.data[field] >= 0
          && (
            (field in resource.data)
              ? (request.resource.data[field] == resource.data[field] + 1)
              : (request.resource.data[field] == 1)
          )
        );
    }

    // Validates synchronized likedBy array and likesCount counter changes by non-owners,
    // ensuring likesCount increment/decrement strictly matches adding/removing the caller's own UID.
    function isValidLikeSync() {
      let diffKeys = request.resource.data.diff(resource.data).affectedKeys();
      let hasLikedBy = 'likedBy' in diffKeys;
      let hasLikesCount = 'likesCount' in diffKeys;
      let currentLikedBy = resource.data.get('likedBy', []);
      let currentCount = resource.data.get('likesCount', 0);
      let newCount = request.resource.data.get('likesCount', 0);

      return (!hasLikedBy && !hasLikesCount)
        || (
          hasLikedBy && hasLikesCount
          && request.resource.data.likedBy is list
          && newCount is int
          && (
            // Liking: caller adds self to likedBy AND likesCount increases by 1
            (
              request.auth.uid in request.resource.data.likedBy
              && !(request.auth.uid in currentLikedBy)
              && request.resource.data.likedBy.hasAll(currentLikedBy)
              && request.resource.data.likedBy.size() == currentLikedBy.size() + 1
              && newCount == currentCount + 1
            )
            ||
            // Unliking: caller removes self from likedBy AND likesCount decreases by 1
            (
              !(request.auth.uid in request.resource.data.likedBy)
              && request.auth.uid in currentLikedBy
              && currentLikedBy.hasAll(request.resource.data.likedBy)
              && request.resource.data.likedBy.size() == currentLikedBy.size() - 1
              && newCount == (currentCount > 0 ? currentCount - 1 : 0)
            )
          )
        );
    }

    // ── Users ──────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId)
        || (
          isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys().size() == 1
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['followersCount'])
          && isValidCounterDelta('followersCount')
        );
      allow delete: if isOwner(userId);

      // ── Notifications subcollection ────────────────────────────────────
      match /notifications/{notificationId} {
        // Only the owner can read their notifications
        allow read: if isOwner(userId);

        // Any signed-in user can create a notification, but MUST specify themselves as the actor/sender
        allow create: if isSignedIn()
          && (
            (!('actorId' in request.resource.data) || request.resource.data.actorId == request.auth.uid)
            && (!('senderId' in request.resource.data) || request.resource.data.senderId == request.auth.uid)
            && (('actorId' in request.resource.data) || ('senderId' in request.resource.data))
          );

        // Only the recipient (owner) can update (mark as read) or delete
        allow update, delete: if isOwner(userId);
      }

      // ── Saved Links subcollection ──────────────────────────────────────
      match /savedLinks/{linkId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ── User Preferences & Reports ─────────────────────────────────────────
    match /users/{userId}/preferences/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if false; 
    }

    // ── Follows ────────────────────────────────────────────────────────────
    match /follows/{followId} {
      allow read: if isSignedIn() && (
        resource == null
        || resource.data.followerId == request.auth.uid
        || resource.data.followedId == request.auth.uid
        || canViewUserFollows(resource.data.followedId)
        || canViewUserFollows(resource.data.followerId)
      );

      allow create: if isSignedIn()
        && request.resource.data.followerId == request.auth.uid
        && request.resource.data.followedId != request.auth.uid
        && exists(/databases/$(database)/documents/users/$(request.resource.data.followedId));

      // CRITICAL SECURITY FIX:
      // 1. followerId and followedId must be strictly immutable
      // 2. Only the followedId (target user) can accept and update status to 'active'
      //    A follower cannot approve their own follow request on a private account!
      allow update: if isSignedIn()
        && resource.data.followedId == request.auth.uid
        && request.resource.data.followerId == resource.data.followerId
        && request.resource.data.followedId == resource.data.followedId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']);

      allow delete: if isSignedIn() && (
        resource.data.followerId == request.auth.uid ||
        resource.data.followedId == request.auth.uid
      );
    }

    // ── Chats ─────────────────────────────────────────────────────────────
    match /chats/{chatId} {
      allow read: if isSignedIn()
        && request.auth.uid in resource.data.participantIds;
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participantIds;
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participantIds;
      allow delete: if isSignedIn()
        && request.auth.uid in resource.data.participantIds;
    }

    // ── Messages Collection Group ──────────────────────────────────────
    // Used for global message listener across all chats
    match /{path=**}/messages/{messageId} {
      allow read: if isSignedIn() 
        && request.auth.uid in resource.data.participantIds;
    }

    // ── Messages subcollection ─────────────────────────────────────────
    // For direct path access
    match /chats/{chatId}/messages/{messageId} {
      allow read: if isChatParticipant(chatId);
      allow create: if isChatParticipant(chatId)
        && request.resource.data.senderId == request.auth.uid;
      // Update rules:
      // 1. Sender can edit/delete own message (including deletedForEveryone & isDeleted)
      // 2. Any participant can update reactions and read receipts
      allow update: if isChatParticipant(chatId)
        && request.resource.data.chatId == resource.data.chatId
        && request.resource.data.senderId == resource.data.senderId
        && request.resource.data.messageId == resource.data.messageId
        && (
          // Sender can update their own message
          (
            resource.data.senderId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'content',
              'mediaUrl',
              'thumbnailUrl',
              'isEdited',
              'updatedAt',
              'isDeleted',
              'deletedForEveryone',
              'reactions',
              'readReceipts',
              'deliveryReceipts',
              'messageStatus',
              'readAt',
              'deliveredAt'
            ])
            && (
              // If deletedForEveryone is requested, enforce 1-hour window from creation
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['deletedForEveryone'])
              || request.resource.data.deletedForEveryone != true
              || (request.time.toMillis() - resource.data.createdAt <= 3600000)
            )
          )
          ||
          // Any participant can update reactions, receipts, and delivery timestamps
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'reactions',
              'readReceipts',
              'deliveryReceipts',
              'messageStatus',
              'readAt',
              'deliveredAt',
              'updatedAt'
            ])
          )
        );
      allow delete: if isChatParticipant(chatId)
        && resource.data.senderId == request.auth.uid;
    }

    // ── Notes ─────────────────────────────────────────────────────────────
    match /notes/{noteId} {
      allow read: if canViewUserContent(resource.data.authorId);

      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.noteType in ['TEXT', 'MUSIC', 'LOCATION', 'COUNTDOWN', 'GIF'];

      allow update: if isSignedIn() && (
        (resource.data.authorId == request.auth.uid && request.resource.data.authorId == resource.data.authorId)
        || (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['likesCount', 'likedBy'])
          && isValidLikeSync()
        )
      );

      allow delete: if isSignedIn()
        && resource.data.authorId == request.auth.uid;
    }

    // ── Stories ───────────────────────────────────────────────────────────
    match /stories/{storyId} {
      allow read: if canViewUserContent(resource.data.authorId);

      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid;

      allow update: if isSignedIn() && (
        (resource.data.authorId == request.auth.uid && request.resource.data.authorId == resource.data.authorId)
        || (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['viewsCount', 'likesCount', 'likedBy'])
          && isValidIncrementOnlyDelta('viewsCount')
          && isValidLikeSync()
        )
      );

      allow delete: if isSignedIn()
        && resource.data.authorId == request.auth.uid;

      match /viewers/{viewerId} {
        allow read, write: if isSignedIn() && (
          request.auth.uid == viewerId
          || (resource != null && resource.data.get('authorId', '') == request.auth.uid)
          || get(/databases/$(database)/documents/stories/$(storyId)).data.authorId == request.auth.uid
        );
      }

      match /likes/{userId} {
        allow read, write: if isSignedIn() && (
          request.auth.uid == userId
          || (resource != null && resource.data.get('authorId', '') == request.auth.uid)
          || get(/databases/$(database)/documents/stories/$(storyId)).data.authorId == request.auth.uid
        );
      }
    }

    // ── Links ─────────────────────────────────────────────────────────────
    match /links/{linkId} {
      allow read: if canViewUserContent(resource.data.authorId);

      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid;

      allow update: if isSignedIn() && (
        (resource.data.authorId == request.auth.uid && request.resource.data.authorId == resource.data.authorId)
        || (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['likesCount', 'sharesCount', 'relinksCount', 'savesCount', 'viewsCount', 'commentsCount'])
          && isValidCounterDelta('likesCount')
          && isValidIncrementOnlyDelta('sharesCount')
          && isValidCounterDelta('relinksCount')
          && isValidCounterDelta('savesCount')
          && isValidIncrementOnlyDelta('viewsCount')
          && isValidCounterDelta('commentsCount')
        )
      );

      allow delete: if isSignedIn()
        && resource.data.authorId == request.auth.uid;

      match /likes/{userId} {
        allow read, write: if isSignedIn() && (
          request.auth.uid == userId
          || (resource != null && resource.data.get('authorId', '') == request.auth.uid)
          || get(/databases/$(database)/documents/links/$(linkId)).data.authorId == request.auth.uid
        );
      }

      match /relinks/{userId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      match /descriptionHistory/{versionId} {
        allow read: if canViewUserContent(get(/databases/$(database)/documents/links/$(linkId)).data.authorId);
        allow create: if isSignedIn() && request.auth.uid == get(/databases/$(database)/documents/links/$(linkId)).data.authorId;
      }
    }

    // ── Comments ──────────────────────────────────────────────────────────
    match /comments/{commentId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid;

      allow update: if isSignedIn() && (
        (resource.data.authorId == request.auth.uid && request.resource.data.authorId == resource.data.authorId)
        || (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['likesCount', 'likedBy', 'replyCount', 'repliesCount'])
          && isValidCounterDelta('replyCount')
          && isValidCounterDelta('repliesCount')
          && isValidLikeSync()
        )
      );

      allow delete: if isSignedIn()
        && resource.data.authorId == request.auth.uid;

      match /likes/{userId} {
        allow read, write: if isSignedIn() && (
          request.auth.uid == userId
          || (resource != null && resource.data.get('authorId', '') == request.auth.uid)
          || get(/databases/$(database)/documents/comments/$(commentId)).data.authorId == request.auth.uid
        );
      }
    }
  }
}
