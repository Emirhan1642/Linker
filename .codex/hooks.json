{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -Command \"$p=[Console]::In.ReadToEnd(); if($p -match '/code-implementer(\\\\s|\\\"|$)'){ Get-Content '.agents/workflows/code-implementer.md' -Raw }\"",
            "timeout": 30000
          }
        ]
      }
    ]
  }
}
